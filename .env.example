# Production domain. DNS A records required for: app.{DOMAIN}, admin.{DOMAIN}, api.{DOMAIN}
DOMAIN=example.com

# PostgreSQL (used by docker compose)
POSTGRES_USER=partes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=partes_obra

# API database URL (for running uvicorn locally outside Docker;
# inside Docker, compose builds it from the POSTGRES_* values above)
DATABASE_URL=postgresql+psycopg2://partes:change-me@localhost:5432/partes_obra

# JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-string

# Initial admin account, seeded on API startup if it does not exist.
# Change the password after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Upload limits (MB)
MAX_PHOTO_MB=15
MAX_VIDEO_MB=200

# Optional: if another app on this VPS used to serve http://<server-ip> on
# port 80, set this to the server IP and publish that app on 127.0.0.1:8081.
# Caddy will keep proxying http://<server-ip> to it. Leave unset otherwise.
# LEGACY_IP_HOST=203.0.113.10
